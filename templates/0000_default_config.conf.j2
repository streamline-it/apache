#{{ ansible_managed }}
<VirtualHost	{{ apache_main_hostname}}:{{ apache_http_port }}>
	ServerName {{ apache_main_hostname }}:{{ apache_http_port }}
	DocumentRoot {{ apache_host_webcontent_directory_relative }}
	<Directory	"{{ apache_default_webcontent_directory_relative }}">
		AllowOverride none
		Require all granted
	</Directory>
</Virtualhost>
