#{{ ansible_managed }}
<VirtualHost	{{ apache_webserver_name }}:{{ apache_http_port }}>
	ServerName {{ apache_webserver_name }}:{{ apache_http_port }}
	ServerAdmin sa@{{ apache_webserver_name }}
	CustomLog logs/{{ apache_webserver_name }}_access.log combined
	ErrorLog logs/{{ apache_webserver_name }}_error.log
	DocumentRoot {{ apache_virtual_hosts_directory_relative }}/{{ apache_webserver_name }}/html/
	RewriteEngine on
	RewriteRule ^(/.*)$ https://%{HTTP_HOST}$1 [redirect=301]
	<Directory	"{{ apache_virtual_hosts_directory_relative }}/{{ apache_webserver_name }}/html/">
		AllowOverride none
		Require all granted
	</Directory>
</Virtualhost>
